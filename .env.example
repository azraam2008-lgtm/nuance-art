# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...        # yalnızca Realtime "yenile" sinyali için
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...             # GİZLİ: sadece sunucuda kullanılır

# --- Uygulamanın herkese açık adresi (Etsy OAuth dönüş adresi için) ---
APP_URL=https://panel.alanadiniz.com

# --- Oturum çerezini imzalamak için uzun rastgele değer ---
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- API Secret'larını veritabanında AES-256-GCM ile şifrelemek için 32 bayt anahtar ---
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Zamanlanmış senkron (Vercel Cron) ve webhook doğrulama ---
CRON_SECRET=uzun-rastgele-bir-deger
WEBHOOK_SECRET=uzun-rastgele-bir-deger

# Yalnızca geliştirme: true ise bağlı olmayan pazaryerleri simüle edilir, demo verisi ve sipariş simülasyonu açılır
DEMO_MODE=false
